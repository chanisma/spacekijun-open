# ── 웹 앱 (Vite) ──────────────────────────────────────────────
# Supabase 대시보드 › Project Settings › API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Google 로그인·드라이브 (Google Cloud Console › API 및 서비스 › 사용자 인증 정보)
# Supabase Auth 의 Google 공급자와 **같은** OAuth 클라이언트 ID 여야 한다.
VITE_GOOGLE_DRIVE_CLIENT_ID=
# (선택) 공유 드라이브 폴더 — 비우면 각 사용자의 "Spacekijun" 폴더
# VITE_GOOGLE_DRIVE_SHARED_FOLDER_ID=

# (선택) rhwp Studio 주소 — 같은 출처만
# VITE_RHWP_STUDIO_URL=/rhwp-studio/index.html

# ── 로컬 스크립트 전용 (.env.local 에 두고 커밋하지 말 것) ─────────
# SUPABASE_SERVICE_ROLE_KEY=
# SOLAR_API_KEY=
# OPENAI_API_KEY=
