/**
 * 과목 정렬(subjectOrder) 회귀 테스트.
 *
 *   npx tsx scripts/subject-order-test/run.mts
 *
 * 순서: 국어 → 수학 → 영어 → 과학탐구 → 사회탐구 → 한국사 (2026-09-03 사용자 결정)
 * 표기 흔들림(로마숫자·가운뎃점)과 3학년 선택과목 키를 함께 처리해야 한다.
 */
import { sortSubjects } from '../../src/features/evalearn/utils/subjectOrder';

let passed = 0;
const failures: string[] = [];
function eq(name: string, actual: string[], expected: string[]) {
  const a = actual.join(' > ');
  const e = expected.join(' > ');
  if (a === e) passed++;
  else failures.push(`${name}\n      기대: ${e}\n      실제: ${a}`);
}

// ── 1·2학년 표준 과목 ────────────────────────────────────────
eq('기본 6과목',
  sortSubjects(['한국사', '사회탐구', '과학탐구', '영어', '수학', '국어']),
  ['국어', '수학', '영어', '과학탐구', '사회탐구', '한국사']);

// ── 3학년: 선택과목 키가 계열 자리에 온다 ────────────────────
eq('3학년 선택과목',
  sortSubjects(['한국사', '생활과윤리', '영어', '확률과통계', '화법과작문']),
  ['화법과작문', '확률과통계', '영어', '생활과윤리', '한국사']);

eq('국어 선택 둘',
  sortSubjects(['언어와매체', '화법과작문']),
  ['화법과작문', '언어와매체']);

eq('수학 선택 셋',
  sortSubjects(['기하', '미적분', '확률과통계']),
  ['확률과통계', '미적분', '기하']);

// ── 과탐이 사탐보다 앞 ───────────────────────────────────────
eq('과탐 먼저',
  sortSubjects(['사회문화', '생명과학Ⅰ', '한국사', '지구과학Ⅰ']),
  ['생명과학Ⅰ', '지구과학Ⅰ', '사회문화', '한국사']);

eq('과학 Ⅰ이 Ⅱ보다 앞',
  sortSubjects(['화학Ⅱ', '물리학Ⅰ', '지구과학Ⅱ', '생명과학Ⅰ']),
  ['물리학Ⅰ', '생명과학Ⅰ', '화학Ⅱ', '지구과학Ⅱ']);

// ── 표기 흔들림 흡수 ─────────────────────────────────────────
eq('아라비아 표기도 같은 자리',
  sortSubjects(['사회문화', '생명과학1', '한국사', '물리학1']),
  ['물리학1', '생명과학1', '사회문화', '한국사']);

eq('가운뎃점 표기',
  sortSubjects(['한국사', '사회·문화', '영어']),
  ['영어', '사회·문화', '한국사']);

// ── 한국사는 항상 맨 뒤(탐구보다 뒤) ─────────────────────────
eq('한국사 최후미',
  sortSubjects(['한국사', '경제', '통합과학', '국어']),
  ['국어', '통합과학', '경제', '한국사']);

// ── 목록에 없는 과목은 뒤로, 가나다순 ────────────────────────
eq('미등록 과목은 뒤',
  sortSubjects(['제2외국어', '국어', '한문', '한국사']),
  ['국어', '한국사', '제2외국어', '한문']);

// ── 원본을 훼손하지 않는다 ───────────────────────────────────
{
  const input = ['한국사', '국어'];
  sortSubjects(input);
  eq('입력 배열 불변', input, ['한국사', '국어']);
}

eq('빈 배열', sortSubjects([]), []);

console.log(`\n통과 ${passed} / 실패 ${failures.length}`);
if (failures.length > 0) {
  for (const f of failures) console.error('  ✗ ' + f);
  process.exit(1);
}
console.log('OK');
