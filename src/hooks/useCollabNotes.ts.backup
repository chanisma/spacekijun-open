    onSuccess: (data) => {
      queryClient.invalidateQueries({
        queryKey: ['collab-notes', data.board_id],
      });
      queryClient.invalidateQueries({ queryKey: ['collab-note', data.id] });
    },
  });
}

// Create comment
export function useCreateComment() {
  const queryClient = useQueryClient();
  const { user } = useAuth();

  return useMutation({
    mutationFn: async ({
      noteId,
      content,
    }: {
      noteId: string;
      content: string;
    }) => {
      if (!user?.id) throw new Error('User not authenticated');

      // Get current user's resource_id
      const { data: userResource, error: resourceError } = await supabase
        .from('user_resource')
        .select('resource_id')
        .eq('user_id', user.id)
        .single();

      if (resourceError || !userResource) {
        throw new Error('User resource not found. Please connect your profile first.');
      }

      const { data, error } = await supabase
        .from('collab_note_comments')
        .insert({
          note_id: noteId,
          author_id: userResource.resource_id,
          content,
        })
        .select(`
          *,
          resource:author_id(id, name)
        `)
        .single();

      if (error) throw error;

      return {
        ...data,
        author: data.resource,
      } as CollabNoteComment;
    },
    onSuccess: (data) => {
      queryClient.invalidateQueries({ queryKey: ['collab-note', data.note_id] });
      // Also invalidate the notes list to update comment count
      queryClient.invalidateQueries({ queryKey: ['collab-notes'] });
    },
  });
}

// Delete comment
export function useDeleteComment() {
  const queryClient = useQueryClient();

  return useMutation({
    mutationFn: async ({
      commentId,
      noteId,
    }: {
      commentId: string;
      noteId: string;
    }) => {
      const { error } = await supabase
        .from('collab_note_comments')
        .delete()
        .eq('id', commentId);

      if (error) throw error;
      return { commentId, noteId };
    },
    onSuccess: (data) => {
      queryClient.invalidateQueries({ queryKey: ['collab-note', data.noteId] });
      queryClient.invalidateQueries({ queryKey: ['collab-notes'] });
    },
  });
}

// Archive note
export function useArchiveNote() {
  const queryClient = useQueryClient();

  return useMutation({
    mutationFn: async (noteId: string) => {
      const { data, error } = await supabase
        .from('collab_notes')
        .update({
          is_archived: true,
          archived_at: new Date().toISOString(),
        })
        .eq('id', noteId)
        .select()
        .single();

      if (error) throw error;
      return data;
    },
    onSuccess: (data) => {
      queryClient.invalidateQueries({
        queryKey: ['collab-notes', data.board_id],
      });
      queryClient.invalidateQueries({ queryKey: ['collab-note', data.id] });
    },
  });
}

// Unarchive note
export function useUnarchiveNote() {
  const queryClient = useQueryClient();

  return useMutation({
    mutationFn: async (noteId: string) => {
      const { data, error } = await supabase
        .from('collab_notes')
        .update({
          is_archived: false,
          archived_at: null,
        })
        .eq('id', noteId)
        .select()
        .single();

      if (error) throw error;
      return data;
    },
    onSuccess: (data) => {
      queryClient.invalidateQueries({
        queryKey: ['collab-notes', data.board_id],
      });
      queryClient.invalidateQueries({ queryKey: ['collab-note', data.id] });
    },
  });
}
